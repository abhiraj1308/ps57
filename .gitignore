# ==============================
# PS57 - Git Ignore
# ==============================

# ------------------------------
# Python
# ------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python tooling
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Packaging
build/
dist/
*.egg-info/
.eggs/
wheels/
*.egg
MANIFEST

# ------------------------------
# Environment / Secrets
# ------------------------------
.env
.env.*
!.env.example

# ------------------------------
# Databases
# ------------------------------
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal

# ------------------------------
# Node / React
# ------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
dist/

# ------------------------------
# PS57 Datasets
# ------------------------------
# Keep the dataset directory itself visible in Git,
# but don't commit actual dataset files.
datasets/*
!datasets/.gitkeep

# ------------------------------
# ML Models
# ------------------------------
# Keep the models directory visible in Git,
# but don't commit large model weights.
models/*
!models/.gitkeep

# Model weights
*.pt
*.pth
*.onnx
*.engine
*.weights
*.ckpt

# ------------------------------
# Logs
# ------------------------------
*.log

# ------------------------------
# OS files
# ------------------------------
.DS_Store
Thumbs.db

# ------------------------------
# VS Code
# ------------------------------
.vscode/

# ------------------------------
# Temporary files
# ------------------------------
tempCodeRunnerFile.py
*.tmp
*.temp
*.swp
*.swo

# ------------------------------
# Jupyter
# ------------------------------
.ipynb_checkpoints/

# ------------------------------
# PyInstaller
# ------------------------------
*.manifest
*.spec

# ------------------------------
# Documentation build
# ------------------------------
docs/_build/
.site/

# ------------------------------
# Local configuration
# ------------------------------
*.local